<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <permission
        android:name="app.infinitum.nether.ACCESS_VAULT"
        android:protectionLevel="signature" />
    <uses-permission android:name="app.infinitum.nether.ACCESS_VAULT" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="app.infinitum.nether" />
        <provider android:authorities="app.infinitum.nether.vault" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Throne"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".NetherActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name="app.infinitum.nether.ui.VaultBlobProvider"
            android:authorities="com.infinitum.throne.suite.nether"
            android:exported="true"
            android:grantUriPermissions="false"
            android:permission="app.infinitum.nether.ACCESS_VAULT" />
        <activity
            android:name=".ShellActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
