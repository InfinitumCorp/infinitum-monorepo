{
  "name": "architect",
  "version": "0.1.0",
  "description": ":\\ARCHITECT\\™ (Architect) — Infinitum's autonomous AI execution engine",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');fs.cpSync('src/conjure','dist/conjure',{recursive:true});fs.cpSync('src/openclaw','dist/openclaw',{recursive:true});fs.cpSync('src/search','dist/search',{recursive:true});fs.cpSync('src/brains/ai-budget.mjs','dist/brains/ai-budget.mjs');fs.cpSync('src/brains/ai-budget.d.mts','dist/brains/ai-budget.d.mts')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "extension:icons": "node scripts/extension.mjs icons",
    "extension:zip": "node scripts/extension.mjs zip"
  },
  "keywords": [
    "ai-agent",
    "browser-automation",
    "playwright",
    "claude",
    "infinitum"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.81",
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "playwright": "^1.64.1",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@playwright/mcp": "0.0.84"
  },
  "peerDependenciesMeta": {
    "@playwright/mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "types": "dist/index.d.ts",
  "bin": {
    "architect": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    },
    "./adapter": {
      "types": "./dist/adapter.d.ts",
      "default": "./dist/adapter.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "web",
    "README.md"
  ],
  "overrides": {
    "zod": "$zod"
  }
}
